{
  "manifest_version": 3,
  "name": "yt2anki",
  "description": "Turn YouTube videos into Anki cards.",
  "version": "0.1.1",
  "minimum_chrome_version": "138",
  "permissions": [
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage"
  ],
  "optional_permissions": ["downloads", "downloads.open"],
  "host_permissions": [],
  "optional_host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "yt2anki",
    "default_icon": {
      "16": "icons/action-16.png",
      "20": "icons/action-20.png",
      "24": "icons/action-24.png",
      "32": "icons/action-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'; frame-src https://www.youtube.com; base-uri 'none'; form-action 'none'"
  }
}
