{
  "name": "yt2anki",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.js\"",
    "test:anki:apkg": "node scripts/verify-apkg-import.mjs",
    "test:anki:live": "pnpm build && node scripts/verify-anki-connect.mjs",
    "test:anki:playback": "node scripts/verify-anki-playback.mjs",
    "test:browsers:live": "pnpm build && node scripts/verify-branded-browsers.mjs",
    "test:e2e": "pnpm build && playwright test e2e/extension.spec.js",
    "test:gemini:live": "pnpm build && playwright test e2e/live-gemini.spec.js",
    "test:e2e:live": "pnpm build && playwright test e2e/live-youtube.spec.js",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:build"
  },
  "dependencies": {
    "ankipack": "^0.1.3",
    "fflate": "^0.8.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
